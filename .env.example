# Supabase Project Credentials (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Secret (Never expose in browser code!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional social link shown to applicants upon submission
NEXT_PUBLIC_AWS_CLUB_SOCIAL_URL=
