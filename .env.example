# Public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public link shown after a successful application.
NEXT_PUBLIC_AWS_CLUB_SOCIAL_URL=

# Local testing only. Demo admin is disabled in production even if these are set.
ENABLE_DEMO_ADMIN=false
NEXT_PUBLIC_ENABLE_DEMO_ADMIN=false
